{
  "manifest_version": 3,
  "name": "Skepnad Kamera",
  "version": "1.1.0",
  "description": "Använd din Skepnad-avatar, bakgrund, filter och röst i samtal i webbläsaren – Messenger, Google Meet, Discord, Zoom, Teams och YouTube Live.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Skepnad Kamera", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ]
}
